<?xml version="1.0" encoding="utf-8"?>
<!--
  Passphrase dialog for the remote backup. Two fields and one acknowledgement:
  the confirmation catches a typo, and the tick makes the irreversible part a
  decision the user made rather than a paragraph they scrolled past.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/msg_backup_passphrase_irreversible"
        android:textAppearance="?android:textAppearanceSmall" />

    <EditText
        android:id="@+id/input_backup_passphrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_backup_passphrase"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:singleLine="true" />

    <EditText
        android:id="@+id/input_backup_passphrase_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/hint_backup_passphrase_confirm"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:singleLine="true"
        tools:text="••••••" />

    <CheckBox
        android:id="@+id/check_backup_passphrase_irreversible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_backup_passphrase_irreversible" />
</LinearLayout>
