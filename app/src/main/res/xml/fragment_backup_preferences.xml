<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/title_backup_preference_category">
        <Preference
            android:icon="@drawable/ic_folder_open"
            android:key="@string/key_backup_location"
            android:summary="@string/summary_select_backup_file"
            android:title="@string/title_select_backup_file" />
        <Preference
            android:icon="@drawable/ic_backup"
            android:key="@string/key_create_backup"
            android:summary="@string/summary_create_backup_pref"
            android:title="@string/title_create_backup_pref" />
        <Preference
            android:icon="@drawable/ic_restore"
            android:key="@string/key_restore_backup"
            android:summary="@string/summary_restore_backup_pref"
            android:title="@string/title_restore_backup" />
        <Preference
            android:icon="@drawable/ic_import_backup"
            android:key="@string/key_import_backup_file"
            android:summary="@string/summary_import_backup_file"
            android:title="@string/title_import_backup_file" />
        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_dropbox"
            android:key="@string/key_dropbox_sync"
            android:summary="@string/summary_dropbox_sync"
            android:title="@string/title_dropbox_sync_preference" />

        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_owncloud"
            android:key="@string/key_owncloud_sync"
            android:summary="@string/summary_owncloud_sync"
            android:title="@string/title_owncloud_sync_preference" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/key_delete_transaction_backup"
            android:summary="@string/summary_delete_transaction_backup"
            android:title="@string/title_delete_transaction_backup" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/key_import_book_backup"
            android:summary="@string/summary_import_book_backup"
            android:title="@string/title_import_book_backup" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/title_export_preference_category">

        <ListPreference
            android:defaultValue="XML"
            android:entries="@array/export_formats"
            android:entryValues="@array/key_export_format_values"
            android:key="@string/key_default_export_format"
            android:summary="@string/summary_default_export_format"
            android:title="@string/title_default_export_format" />
        <EditTextPreference
            android:icon="@drawable/ic_attach_email"
            android:inputType="textEmailAddress"
            android:key="@string/key_default_export_email"
            android:summary="@string/summary_default_export_email"
            android:title="@string/title_default_export_email" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/key_export_all_transactions"
            android:summary="@string/hint_export_choice"
            android:title="@string/title_export_all_transactions" />
        <SwitchPreference
            android:icon="@drawable/ic_delete"
            android:key="@string/key_delete_transactions_after_export"
            android:summary="@string/hint_delete_after_export"
            android:title="@string/title_always_delete_exported_transactions" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/key_xml_ofx_header"
            android:summary="@string/summary_xml_ofx_header"
            android:title="@string/title_xml_ofx_header" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/key_compress_export"
            android:title="@string/option_compress_export" />
    </PreferenceCategory>

    <!--
      WebDAV remote backup (feature ② v1). The address/user/password rows persist themselves
      through androidx.preference; WebDavPreferences reads that same store.
    -->
    <PreferenceCategory android:title="@string/title_webdav_category">

        <EditTextPreference
            android:dialogTitle="@string/title_webdav_server_url"
            android:inputType="textUri"
            android:key="@string/key_webdav_server_url"
            android:summary="@string/summary_webdav_server_url"
            android:title="@string/title_webdav_server_url" />

        <EditTextPreference
            android:dialogTitle="@string/title_webdav_username"
            android:inputType="textNoSuggestions"
            android:key="@string/key_webdav_username"
            android:summary="@string/summary_webdav_username"
            android:title="@string/title_webdav_username" />

        <EditTextPreference
            android:dialogTitle="@string/title_webdav_password"
            android:inputType="textPassword"
            android:key="@string/key_webdav_password"
            android:summary="@string/summary_webdav_password_unset"
            android:title="@string/title_webdav_password" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_webdav_trust_all"
            android:summary="@string/summary_webdav_trust_all"
            android:title="@string/title_webdav_trust_all" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_webdav_allow_plaintext"
            android:summary="@string/summary_webdav_allow_plaintext"
            android:title="@string/title_webdav_allow_plaintext" />

        <Preference
            android:key="@string/key_webdav_test_connection"
            android:summary="@string/summary_webdav_test_connection"
            android:title="@string/title_webdav_test_connection" />

        <Preference
            android:key="@string/key_webdav_backup_now"
            android:summary="@string/summary_webdav_backup_now"
            android:title="@string/title_webdav_backup_now" />

        <Preference
            android:key="@string/key_webdav_restore_now"
            android:summary="@string/summary_webdav_restore_now"
            android:title="@string/title_webdav_restore_now" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_webdav_two_way_sync"
            android:summary="@string/summary_webdav_two_way_sync"
            android:title="@string/title_webdav_two_way_sync" />

        <Preference
            android:key="@string/key_webdav_sync_now"
            android:summary="@string/summary_webdav_sync_now"
            android:title="@string/title_webdav_sync_now" />
    </PreferenceCategory>

</PreferenceScreen>
